# Copy to .env on the VPS (root, 0600). Never commit the real file.
# First boot generates .env automatically; this file documents the variables
# for manual recreation.

# Local admin account for the embedded IdP (dashboard login). Generate the
# password shell-safe (openssl rand -hex 24): .env is sourced as shell code.
# The bcrypt hash is derived from the password at render time; keeping it out
# of .env avoids docker compose interpolation warnings on its $ characters.
NETBIRD_ADMIN_EMAIL=
NETBIRD_ADMIN_PASSWORD=

# Random secrets rendered into config.yaml. Generate with openssl rand.
NETBIRD_AUTH_SECRET=
NETBIRD_STORE_ENCRYPTION_KEY=
NB_SESSION_COOKIE_ENCRYPTION_KEY=

# Shared secret for the primary-mesh relay (netbird-relay.mia.cx). The same
# value must be set in the primary server's .env so it can authenticate
# against this relay. Generate with openssl rand -base64 32.
NETBIRD_RELAY_AUTH_SECRET=
