# Dashboard config for the embedded IdP (no secrets; AUTH_CLIENT_SECRET stays
# empty because netbird-dashboard is a public client).
NETBIRD_MGMT_API_ENDPOINT=https://netbird.mia.cx
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://netbird.mia.cx
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=https://netbird.mia.cx/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
