# Combined NetBird server config, rendered with envsubst from .env at deploy
# time (see README). ${VARS} are placeholders, not shell syntax in the output.
server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.mia.cx:443"
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"
  authSecret: "${NETBIRD_AUTH_SECRET}"
  dataDir: "/var/lib/netbird"

  # Primary-mesh relay and STUN run on the Repair VPS (hosts/yggdrasil-repair-1).
  # Setting relays turns off the embedded relay. The secret is shared only with
  # that relay.
  stuns:
    - uri: "stun:netbird-relay.mia.cx:3479"
  relays:
    addresses:
      - "rels://netbird-relay.mia.cx:443"
    credentialsTTL: "12h"
    secret: "${NETBIRD_RELAY_AUTH_SECRET}"

  auth:
    issuer: "https://netbird.mia.cx/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "${NB_SESSION_COOKIE_ENCRYPTION_KEY}"
    dashboardRedirectURIs:
      - "https://netbird.mia.cx/nb-auth"
      - "https://netbird.mia.cx/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
    # Initial local admin for the embedded IdP. Password is a bcrypt hash.
    owner:
      email: "${NETBIRD_ADMIN_EMAIL}"
      password: "${NETBIRD_ADMIN_PASSWORD_HASH}"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.0/24"

  store:
    engine: "sqlite"
    encryptionKey: "${NETBIRD_STORE_ENCRYPTION_KEY}"
