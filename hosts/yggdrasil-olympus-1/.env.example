# Copy to .env on the VM (root, 0600). Never commit the real file.

# Cloudflare API token with DNS edit rights on mia.cx for the Traefik DNS-01
# certificate on :8443. Same value as cluster secret
# cert-manager/cloudflare-api-token.
CF_DNS_API_TOKEN=

# Local admin account for the embedded IdP (dashboard login). Generate the
# password shell-safe (openssl rand -hex 24): .env is sourced as shell code.
# The bcrypt hash is derived from the password at render time; keeping it out
# of .env avoids docker compose interpolation warnings on its $ characters.
NETBIRD_ADMIN_EMAIL=
NETBIRD_ADMIN_PASSWORD=

# Random secrets rendered into config.yaml. Generate with openssl rand.
NETBIRD_AUTH_SECRET=
NETBIRD_STORE_ENCRYPTION_KEY=
NB_SESSION_COOKIE_ENCRYPTION_KEY=

# Shared secret for the external relay on netbird-relay.mia.cx (Repair VPS).
# Must equal NETBIRD_RELAY_AUTH_SECRET in /opt/netbird/.env there.
NETBIRD_RELAY_AUTH_SECRET=

# One-off setup key for the netbird-router peer (admin API, auto-group
# routers-olympus). Spent after the first enrollment; the peer keeps working.
NB_ROUTER_SETUP_KEY=

# One-off setup key for the netbird-dns sidecar peer (admin API, auto-group
# dns-adguard). Spent after the first enrollment; the peer keeps working.
NB_DNS_SETUP_KEY=

# AdGuard admin login for the UI on http://10.0.1.4:3000. Shell-safe
# (openssl rand -hex 24); the bcrypt hash is derived at render time.
ADGUARD_ADMIN_PASSWORD=
